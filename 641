class MyCircularDeque {
private:
    vector<int> arr;
    int front;
    int rear;
    int count;
    int capacity;

public:
    MyCircularDeque(int k) {
        arr.resize(k);
        capacity = k;
        front = 0;
        rear = -1;
        count = 0;
    }
    
    bool insertFront(int value) {
        if (isFull()) {
            return false;
        }

        front = (front - 1 + capacity) % capacity;
        arr[front] = value;

        if (count == 0) {
            rear = front;
        }

        count++;
        return true;
    }
    
    bool insertLast(int value) {
        if (isFull()) {
            return false;
        }

        rear = (rear + 1) % capacity;
        arr[rear] = value;

        if (count == 0) {
            front = rear;
        }

        count++;
        return true;
    }
    
    bool deleteFront() {
        if (isEmpty()) {
            return false;
        }

        front = (front + 1) % capacity;
        count--;
        return true;
    }
    
    bool deleteLast() {
        if (isEmpty()) {
            return false;
        }

        rear = (rear - 1 + capacity) % capacity;
        count--;
        return true;
    }
    
    int getFront() {
        if (isEmpty()) {
            return -1;
        }

        return arr[front];
    }
    
    int getRear() {
        if (isEmpty()) {
            return -1;
        }

        return arr[rear];
    }
    
    bool isEmpty() {
        return count == 0;
    }
    
    bool isFull() {
        return count == capacity;
    }
};
